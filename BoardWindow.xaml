                <TextBlock x:Name="GroupDropHintText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Popup x:Name="GifSpeedPopup" services:PopupTransitions.Enabled="True" PlacementTarget="{Binding ElementName=GifSpeedButton}" Placement="Bottom"
                   VerticalOffset="14" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
                <Border Background="{DynamicResource CardBrush}" Padding="6" CornerRadius="10" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource DrawingToolButton}" Width="54" Content="0.25×" Tag="0.25" Click="OnGifSpeedSelected" />
                        <Button Style="{StaticResource DrawingToolButton}" Width="54" Content="0.5×" Tag="0.5" Click="OnGifSpeedSelected" />
                        <Button Style="{StaticResource DrawingToolButton}" Width="54" Content="1×" Tag="1" Click="OnGifSpeedSelected" />
                        <Button Style="{StaticResource DrawingToolButton}" Width="54" Content="1.5×" Tag="1.5" Click="OnGifSpeedSelected" />
                        <Button Style="{StaticResource DrawingToolButton}" Width="54" Content="2×" Tag="2" Click="OnGifSpeedSelected" />
                        <Button Style="{StaticResource DrawingToolButton}" Width="54" Content="4×" Tag="4" Click="OnGifSpeedSelected" />
                    </UniformGrid>
                </Border>
            </Popup>
            <Border x:Name="GifFramesPanel" Panel.ZIndex="75" Width="366" Padding="10" CornerRadius="12"
                    Visibility="Collapsed" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".18" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DrawingToolButton}" Width="28" Height="28" ToolTip="关闭帧面板" Click="OnGifFramesClick">
                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Data="M1,1 L13,13 M13,1 L1,13" />
                        </Button>
                        <TextBlock x:Name="GifFramesTitle" Text="全部帧" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0" />
                    </DockPanel>
                    <ListBox x:Name="GifFramesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnGifFrameSelected"
                             PreviewMouseLeftButtonDown="OnGifFramePointerDown">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="FrameChrome" CornerRadius="8" Background="{DynamicResource SubtleBrush}" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="FrameChrome" Property="BorderBrush" Value="#5C9DB8" /></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FrameChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Width="94" Height="76">
                                <Image Source="{Binding Image}" Stretch="Uniform" />
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#B522272C" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="10" />
                                </Border>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border x:Name="ImageLinkButtons" Panel.ZIndex="70" Padding="3" CornerRadius="9"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImageWebLinkButton" Style="{StaticResource DrawingToolButton}" Width="30" Height="28"
                            ToolTip="打开网页链接" Click="OnOpenImageWebLink">
                        <Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"
                              Data="M9,1 A8,8 0 1 1 9,17 A8,8 0 1 1 9,1 M1,9 H17 M9,1 C4,5 4,13 9,17 M9,1 C14,5 14,13 9,17" />
                    </Button>
                    <Button x:Name="ImageFileLinkButton" Style="{StaticResource DrawingToolButton}" Width="30" Height="28"
                            ToolTip="打开自定义文件或文件夹" Click="OnOpenImageFileLink">
                        <Path Width="20" Height="17" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M1,5 V2 H8 L10,5 H19 V16 H1 Z M1,6 H19" />
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="TextLinkButtons" Panel.ZIndex="70" Padding="3" CornerRadius="9"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TextWebLinkButton" Style="{StaticResource DrawingToolButton}" Width="30" Height="28"
                            ToolTip="打开网页链接" AutomationProperties.Name="打开注释网页链接" Click="OnOpenTextWebLink">
                        <Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"
                              Data="M9,1 A8,8 0 1 1 9,17 A8,8 0 1 1 9,1 M1,9 H17 M9,1 C4,5 4,13 9,17 M9,1 C14,5 14,13 9,17" />
                    </Button>
                    <Button x:Name="TextFileLinkButton" Style="{StaticResource DrawingToolButton}" Width="30" Height="28"
                            ToolTip="打开自定义文件或文件夹" AutomationProperties.Name="打开注释文件链接" Click="OnOpenTextFileLink">
                        <Path Width="20" Height="17" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M1,5 V2 H8 L10,5 H19 V16 H1 Z M1,6 H19" />
                    </Button>
                </StackPanel>
            </Border>
            <Rectangle x:Name="SelectionRectangle"
