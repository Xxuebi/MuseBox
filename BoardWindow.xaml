                                         PreviewKeyDown="OnGroupFramePaddingTextKeyDown"
                                         LostKeyboardFocus="OnGroupFramePaddingTextLostFocus" />
                                <TextBlock Text="px" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
