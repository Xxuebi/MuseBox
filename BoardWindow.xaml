<Window x:Class="ScreenshotCollector.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ScreenshotCollector.Services"
        Title="画板"
        Icon="Assets/app-icon.ico"
        Width="1100" Height="760" MinWidth="700" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        AllowDrop="True"
        Drop="OnBoardDrop"
        DragOver="OnBoardDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <Style x:Key="BoardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ToolbarTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF8D87FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value=".42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayerToggleButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ToolbarTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="31" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DrawingSliderTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DrawingSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DrawingSliderTrack}"
                                                  Background="#FF65A5BF" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DrawingSliderTrack}"
                                                  Background="#FFDFE2E5" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#FF6593A6" StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DrawingToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#15000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value=".35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DrawingNumberInput" TargetType="TextBox">
            <Setter Property="Width" Value="55" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnDrawingNumericMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Width" Value="73" />
                                <Setter Property="Margin" Value="0,0,-18,0" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF5C9DB8" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FloatingImageButton" TargetType="Button" BasedOn="{StaticResource DrawingToolButton}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{DynamicResource CardBrush}" CornerRadius="7">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ResizeHandle" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="8" Height="8" CornerRadius="2.5"
                                    Background="White" BorderBrush="#857DEF" BorderThickness="1.2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#E8E5FF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#857DEF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RotationHandle" TargetType="Thumb">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="拖动旋转 · Shift 每 5° 吸附" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Grip" Width="6" Height="6" Fill="White"
                                     Stroke="#857DEF" StrokeThickness="1.2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="#857DEF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
    <Border x:Name="BoardWindowFrame" Margin="9"
            Background="Transparent" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity=".38" />
        </Border.Effect>
    <Grid x:Name="BoardSurface"
          Background="{StaticResource CanvasBrush}"
          ClipToBounds="True"
          Focusable="True"
          MouseDown="OnSurfaceMouseDown"
          MouseMove="OnSurfaceMouseMove"
          PreviewMouseMove="OnBoardPointerMove"
          MouseLeave="OnBoardPointerLeave"
          MouseUp="OnSurfaceMouseUp"
          PreviewStylusDown="OnSurfaceStylusDown"
          PreviewStylusMove="OnSurfaceStylusMove"
          PreviewStylusUp="OnSurfaceStylusUp"
          StylusInAirMove="OnBoardStylusHover"
          StylusLeave="OnBoardStylusLeave"
          PreviewMouseRightButtonDown="OnBoardRightButtonDown"
          PreviewMouseRightButtonUp="OnBoardRightButtonUp"
          ContextMenuOpening="OnBoardContextMenuOpening">
        <Grid.ContextMenu>
            <ContextMenu services:PopupTransitions.Enabled="True" Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False">
                <ContextMenu.Resources>
                    <Style TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Margin="9,5" Background="{DynamicResource ControlBorderBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid>
                                        <Border x:Name="ItemChrome" Margin="2,1" Padding="10,6"
                                                Background="Transparent" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Margin="22,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{TemplateBinding InputGestureText}" />
                                                <Path x:Name="SubmenuArrow" Grid.Column="2" Width="5" Height="9"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Fill="{DynamicResource MutedTextBrush}" Visibility="Collapsed"
                                                      Data="M 0,0 L 5,4.5 L 0,9 Z" />
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="PART_Popup" Placement="Right" services:PopupTransitions.Enabled="True"
                                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                               HorizontalOffset="-14" VerticalOffset="-17"
                                               AllowsTransparency="True" PopupAnimation="None"
                                               IsOpen="{TemplateBinding IsSubmenuOpen}">
                                            <Grid>
                                                <Border MinWidth="170" Padding="5" Margin="10"
                                                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                        BorderThickness="1" CornerRadius="9">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" />
                                                    </Border.Effect>
                                                    <StackPanel IsItemsHost="True" />
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SubtleBrush}" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="True">
                                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ItemChrome" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.Resources>
                <ContextMenu.Template>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid>
                            <Border x:Name="MenuChrome" MinWidth="210" Padding="5" Margin="10"
                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.24" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </ContextMenu.Template>
                <MenuItem x:Name="UndoMenuItem" Header="撤回" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
                <MenuItem x:Name="RedoMenuItem" Header="重做" InputGestureText="Ctrl+Y" Click="OnRedoClick" />
                <Separator />
                <MenuItem x:Name="AddTextMenuItem" Header="添加注释" InputGestureText="T" Click="OnAddTextClick" />
                <MenuItem x:Name="DrawMenuItem" Header="绘制" InputGestureText="B" Click="OnDrawClick" />
                <Separator />
                <MenuItem x:Name="CopyMenuItem" Header="复制" InputGestureText="Ctrl+C" Click="OnCopyClick" />
                <MenuItem x:Name="PasteMenuItem" Header="粘贴" Click="OnPasteClick" />
                <MenuItem x:Name="SaveGifFrameMenuItem" Header="另存当前帧为新图片" Visibility="Collapsed" Click="OnSaveGifFrameClick" />
                <Separator />
                <MenuItem x:Name="ArrangeMenuItem" Header="自动排布" Click="OnArrangeClick" />
                <MenuItem x:Name="FitAllMenuItem" Header="适应全部" Click="OnFitAllClick" />
                <MenuItem x:Name="GroupMenuItem" Header="组合" IsEnabled="False" Click="OnGroupImagesClick" />
                <MenuItem x:Name="UngroupMenuItem" Header="解散组合" IsEnabled="False" Click="OnUngroupImagesClick" />
                <Separator />
                <MenuItem x:Name="BringForwardMenuItem" Header="上移一层" Click="OnBringForwardClick" />
                <MenuItem x:Name="SendBackwardMenuItem" Header="下移一层" Click="OnSendBackwardClick" />
                <MenuItem x:Name="BringToFrontMenuItem" Header="置于顶层" Click="OnBringToFrontClick" />
                <MenuItem x:Name="SendToBackMenuItem" Header="置于底层" Click="OnSendToBackClick" />
                <MenuItem x:Name="DeleteMenuItem" Header="删除" Click="OnDeleteClick" />
                <Separator />
                <MenuItem Header="重置图片">
                    <MenuItem x:Name="ResetRotationMenuItem" Header="重置旋转" Click="OnResetRotationClick" />
                    <MenuItem x:Name="ResetSizeMenuItem" Header="重置大小" Click="OnResetSizeClick" />
                    <MenuItem x:Name="ResetImageMenuItem" Header="重置旋转和大小" Click="OnResetImageClick" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="BoardSettingsMenuItem" Header="设置…" Click="OnBoardSettingsClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Canvas x:Name="WorldCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.RenderTransform>
                <MatrixTransform x:Name="ViewTransform" />
            </Canvas.RenderTransform>
        </Canvas>
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="True">
            <Path x:Name="ImageFocusShade" Panel.ZIndex="-1" Fill="#8C000000"
                  IsHitTestVisible="False" Visibility="Collapsed" />
            <Button x:Name="ImageEditToggle" Panel.ZIndex="70" Style="{StaticResource FloatingImageButton}"
                    Background="{DynamicResource CardBrush}" Width="38" Height="30" Visibility="Collapsed"
                    ToolTip="打开图片工具栏" Click="OnImageToolbarToggleClick">
                <Button.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity=".18" /></Button.Effect>
                <Grid Width="22" Height="22">
                    <Path x:Name="ImageEditPencilIcon" Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Data="M2,11 V16 H7 L16,7 L11,2 Z M9,4 L14,9 M2,11 L7,16" />
                    <Path x:Name="GifEditMotionIcon" Width="22" Height="22" Visibility="Collapsed"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,5 H18 Q20,5 20,7 V18 Q20,20 18,20 H5 Q3,20 3,18 V7 Q3,5 5,5 M6,2 H17 M10,9 L15,12.5 L10,16 Z" />
                </Grid>
            </Button>
            <Border x:Name="ImagePalette" Panel.ZIndex="70" Padding="8,6" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="12" RenderTransformOrigin=".5,.5">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".18" /></Border.Effect>
                <Grid>
                <StackPanel x:Name="StaticImageTools" Orientation="Horizontal">
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="编辑图片" Tag="Edit" Click="OnImageEditorClick">
                        <Path Width="19" Height="19" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M1,7 V18 H12 M5,13 L6,9 L14,1 L18,5 L10,13 Z M12,3 L16,7" />
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource ControlBorderBrush}" Margin="7,0" />
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="水平翻转" Tag="Horizontal" Click="OnImageFlipClick">
                        <Path Width="20" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M9,0 V18 M6,3 L1,15 H6 Z M12,3 L17,15 H12 Z" />
                    </Button>
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="垂直翻转" Tag="Vertical" Click="OnImageFlipClick">
                        <Path Width="18" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M0,9 H18 M3,6 L15,1 V6 Z M3,12 L15,17 V12 Z" />
                    </Button>
                    <Button x:Name="ImageRotateButton" Style="{StaticResource DrawingToolButton}" ToolTip="顺时针旋转 90°" Click="OnImageRotateClick">
                        <Path Width="20" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M16,7 A7,7 0 1 0 17,13 M16,1 V7 H10" />
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource ControlBorderBrush}" Margin="7,0" />
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="网页与文件链接" Click="OnImageLinksClick">
                        <Path Width="20" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M7,12 L12,7 M8,5 L11,2 C15,-2 22,5 18,9 L15,12 M12,15 L9,18 C5,22 -2,15 2,11 L5,8" />
                    </Button>
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="收起图片工具栏" Click="OnImageToolbarToggleClick">
                        <Path Width="14" Height="14" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.6" Data="M1,1 L13,13 M13,1 L1,13" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="GifImageTools" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="GifPreviousButton" Style="{StaticResource DrawingToolButton}" ToolTip="上一帧" Tag="-1" Click="OnGifStepClick">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,2 V18 M17,3 L6,10 L17,17 Z" />
                    </Button>
                    <Button x:Name="GifPlaybackButton" Style="{StaticResource DrawingToolButton}" ToolTip="暂停"
                            AutomationProperties.Name="暂停" Click="OnGifPlaybackToggleClick">
                        <Grid Width="20" Height="20">
                            <Path x:Name="GifPlayIcon" Visibility="Collapsed" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" Data="M5,3 L17,10 L5,17 Z" />
                            <Path x:Name="GifPauseIcon" Stroke="{DynamicResource TextBrush}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,3 V17 M14,3 V17" />
                        </Grid>
                    </Button>
                    <Button x:Name="GifNextButton" Style="{StaticResource DrawingToolButton}" ToolTip="下一帧" Tag="1" Click="OnGifStepClick">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M18,2 V18 M3,3 L14,10 L3,17 Z" />
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource ControlBorderBrush}" Margin="7,0" />
                    <Button x:Name="GifSpeedButton" Style="{StaticResource DrawingToolButton}" Width="65" ToolTip="播放倍速" Click="OnGifSpeedClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GifSpeedLabel" Text="1×" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <Path Width="7" Height="4" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Data="M1,1 L4,4 L7,1" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GifFramesButton" Style="{StaticResource DrawingToolButton}" ToolTip="查看所有帧" Click="OnGifFramesClick">
                        <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M1,1 H8 V8 H1 Z M12,1 H19 V8 H12 Z M1,12 H8 V19 H1 Z M12,12 H19 V19 H12 Z" />
                    </Button>
                    <TextBlock x:Name="GifFrameStatus" Text="载入中…" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="7,0" FontSize="11" />
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="网页与文件链接" Click="OnImageLinksClick">
                        <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M7,12 L12,7 M8,5 L11,2 C15,-2 22,5 18,9 L15,12 M12,15 L9,18 C5,22 -2,15 2,11 L5,8" />
                    </Button>
                    <Button Style="{StaticResource DrawingToolButton}" ToolTip="收起工具栏" Click="OnImageToolbarToggleClick">
