                <Ellipse Margin="-1" Stroke="#E5202020" StrokeThickness="1" Fill="#0AFFFFFF" />
            </Grid>
        </Canvas>

        <Border x:Name="LayersPanel" Panel.ZIndex="125" Width="320"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,62,12,12"
                Background="Transparent" BorderThickness="0" Opacity="0" Visibility="Collapsed"
                CornerRadius="13"
                UseLayoutRounding="True" SnapsToDevicePixels="True"
                TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                TextOptions.TextHintingMode="Fixed"
                MouseDown="OnLayersPanelMouseDown">
            <Border.RenderTransform><TranslateTransform x:Name="LayersPanelTranslate" X="340" /></Border.RenderTransform>
            <Grid>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="13" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity=".24" /></Border.Effect>
                </Border>
                <Thumb Width="10" Margin="-2,9,0,9" HorizontalAlignment="Left" Cursor="SizeWE" Background="Transparent"
                        Panel.ZIndex="3" DragDelta="OnLayersResizeDragDelta"
                        PreviewMouseDoubleClick="OnLayersResizeDoubleClick" ToolTip="拖动调整图层面板宽度；双击恢复默认">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Border Width="3" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        CornerRadius="2" Background="{DynamicResource ControlBorderBrush}" Opacity=".7" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Grid Margin="8" RenderOptions.ClearTypeHint="Enabled">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="图层" Margin="8,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Button Width="30" Height="30" HorizontalAlignment="Right" Style="{StaticResource DrawingToolButton}"
                            ToolTip="关闭图层" Click="OnLayersCloseClick">
                        <Path Width="12" Height="12" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="LayersList" Background="Transparent" BorderThickness="0" Padding="0,2"
                             UseLayoutRounding="True" SnapsToDevicePixels="True"
                             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonDown="OnLayerListMouseDown"
                             PreviewMouseWheel="OnLayersListPreviewMouseWheel"
                             PreviewMouseMove="OnLayerListMouseMove" PreviewMouseLeftButtonUp="OnLayerListMouseUp"
                             PreviewKeyDown="OnLayerListKeyDown" PreviewMouseRightButtonDown="OnLayerListRightButtonDown"
                             AllowDrop="True" DragOver="OnLayerListDragOver" DragLeave="OnLayerListDragLeave" Drop="OnLayerListDrop">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource RoundedContextMenu}">
                                <MenuItem Header="重命名" Click="OnRenameLayerMenuClick" />
                                <Separator />
                                <MenuItem Header="上移一层" Click="OnBringForwardClick" />
                                <MenuItem Header="下移一层" Click="OnSendBackwardClick" />
                                <MenuItem Header="置于顶层" Click="OnBringToFrontClick" />
                                <MenuItem Header="置于底层" Click="OnSendToBackClick" />
                                <Separator />
                                <MenuItem Header="组合" Click="OnGroupImagesClick" />
                                <MenuItem Header="解散组合" Click="OnUngroupImagesClick" />
                                <Separator />
                                <MenuItem Header="删除" Click="OnDeleteClick" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" Margin="{Binding Indent}" Tag="{Binding}">
                                    <Border x:Name="RowChrome" CornerRadius="{Binding SelectionCornerRadius}"
                                            Margin="{Binding SelectionChromeMargin}" Background="Transparent"
                                            SnapsToDevicePixels="True" />
                                    <Border x:Name="DropTop" Height="2" Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Top" Visibility="Collapsed" CornerRadius="1" />
                                    <Border x:Name="DropBottom" Height="2" Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Bottom" Visibility="Collapsed" CornerRadius="1" />
                                    <Grid Margin="3,0">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="24" />
                                             <ColumnDefinition Width="25" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ExpandButton" Width="22" Height="22" Padding="0" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Tag="{Binding}"
                                                Click="OnLayerExpandClick">
                                            <Path x:Name="ExpandArrow" Width="7" Height="4" Fill="{DynamicResource TextBrush}"
                                                  RenderTransformOrigin=".5,.5" Data="M0,0 L7,0 L3.5,4 Z" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontFamily="{Binding IconFontFamily}"
                                                   FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock x:Name="LayerNameText" Grid.Column="2" Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   SnapsToDevicePixels="True"
                                                   Foreground="{DynamicResource TextBrush}" />
                                         <TextBox x:Name="LayerNameEditor" Grid.Column="2" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="Collapsed" VerticalContentAlignment="Center" Padding="5,1"
                                                  Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                  Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                                  KeyDown="OnLayerNameEditorKeyDown" />
                                         <StackPanel x:Name="RenameActions" Grid.Column="3" Orientation="Horizontal"
                                                     Margin="4,0,0,0" Visibility="Collapsed">
                                             <Button Width="24" Height="24" Padding="0" Margin="0,0,3,0"
                                                     Style="{StaticResource DrawingToolButton}" ToolTip="确定"
                                                     Click="OnLayerRenameConfirmClick">
                                                 <Path Width="10" Height="8" Stroke="{DynamicResource AccentBrush}"
                                                       StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                       Data="M1,4 L4,7 L9,1" />
                                             </Button>
                                             <Button Width="24" Height="24" Padding="0"
                                                     Style="{StaticResource DrawingToolButton}" ToolTip="取消"
                                                     Click="OnLayerRenameCancelClick">
                                                 <Path Width="9" Height="9" Stroke="{DynamicResource TextBrush}"
                                                       StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                       Data="M1,1 L8,8 M8,1 L1,8" />
                                             </Button>
                                         </StackPanel>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="ExpandButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                        <Setter TargetName="ExpandArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90" /></Setter.Value></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="RowChrome" Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DropBefore}" Value="True"><Setter TargetName="DropTop" Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding DropAfter}" Value="True"><Setter TargetName="DropBottom" Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                         <Setter TargetName="LayerNameText" Property="Visibility" Value="Collapsed" />
                                         <Setter TargetName="LayerNameEditor" Property="Visibility" Value="Visible" />
                                         <Setter TargetName="RenameActions" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="LayersEmptyText" Text="画板中还没有元素" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="Toolbar"
                Panel.ZIndex="100"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,12,0,0" Padding="9"
                Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="1" CornerRadius="10"
                Opacity="1" IsHitTestVisible="True"
                MouseLeftButtonDown="OnToolbarMouseDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarTranslate" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BoardTitle" Margin="6,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ToolbarTextBrush}" FontSize="12" FontWeight="SemiBold" />
                <Border Width="1" Height="20" Margin="6,0" Background="#FF4B4E55" />
                <Button x:Name="SelectToolButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="选择 (V)"
                        Click="OnSelectToolClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE7C9;" />
                </Button>
                <Button x:Name="TextToolButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="添加注释 (T)"
                        Click="OnAddTextClick">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="T" />
                </Button>
                <Button x:Name="DrawToolButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="绘制 (B)"
                        Click="OnDrawClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE70F;" />
                </Button>
                <ToggleButton x:Name="LayersButton" Style="{StaticResource LayerToggleButton}" ToolTip="图层"
                              Checked="OnLayersToggleChanged" Unchecked="OnLayersToggleChanged">
                    <Grid Width="17" Height="17">
                        <Path Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                              Data="M1,5 L8.5,1 L16,5 L8.5,9 Z M1,9 L8.5,13 L16,9 M1,12 L8.5,16 L16,12" />
                    </Grid>
                </ToggleButton>
                <Border Width="1" Height="20" Margin="6,0" Background="#FF4B4E55" />
                <Button x:Name="PinButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="窗口置顶"
                        Click="OnPinClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE718;" />
                </Button>
                <Button x:Name="BoardMinimizeButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="最小化"
                        Click="OnMinimizeClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE921;" />
                </Button>
                <Button x:Name="BoardFullscreenButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="全屏 (F11)"
                        Click="OnFullscreenClick">
                    <Path x:Name="BoardFullscreenIcon" Width="16" Height="16" Stroke="{DynamicResource ToolbarTextBrush}"
                          StrokeThickness="1.5" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1,6 V1 H6 M10,1 H15 V6 M15,10 V15 H10 M6,15 H1 V10" />
                </Button>
                <Button x:Name="BoardCloseButton" Width="31" Padding="0"
                        Style="{StaticResource BoardButton}" ToolTip="关闭"
                        Click="OnCloseClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Border>

        <Button x:Name="ToolbarToggleButton" Panel.ZIndex="101"
                Width="20.4" Height="10.2" MinHeight="0" Padding="0"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Focusable="False" Cursor="Hand"
                ToolTip="收起顶部菜单"
                Click="OnToolbarToggleClick">
            <Button.RenderTransform>
                <TranslateTransform x:Name="ToolbarToggleTranslate" Y="57" />
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ToggleChrome"
                            Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                            BorderThickness=".6,0,.6,.6" CornerRadius="0,0,4.8,4.8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
                            <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Path x:Name="ToolbarToggleArrow" Width="5.4" Height="3" Stretch="Fill"
                  RenderTransformOrigin=".5,.5"
                  Fill="{DynamicResource ToolbarTextBrush}"
                  Data="M 0,0 L 9,0 L 4.5,5 Z">
                <Path.RenderTransform>
                    <RotateTransform x:Name="ToolbarToggleArrowRotate" Angle="180" />
                </Path.RenderTransform>
            </Path>
        </Button>

        <Border x:Name="TextPalette" Panel.ZIndex="110"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="0" Padding="8"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1" CornerRadius="13"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TextPaletteTranslate" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
            </Border.Effect>
            <Border.Resources>
                <Style x:Key="TextPaletteButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="#15000000" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="TextPaletteCombo" TargetType="ComboBox">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="MaxDropDownHeight" Value="310" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid x:Name="ComboRoot">
                                    <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                                  Background="{TemplateBinding Background}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                                        CornerRadius="7">
                                                    <Grid>
                                                        <ContentPresenter Margin="11,0,30,0"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                        <Path Width="9" Height="5" Margin="0,0,11,0"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                                                              Data="M 0 0 L 4.5 4.5 L 9 0" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup x:Name="PART_Popup" services:PopupTransitions.Enabled="True" Placement="Bottom" AllowsTransparency="True"
                                           Focusable="False" PopupAnimation="None"
                                           IsOpen="{TemplateBinding IsDropDownOpen}">
                                        <Border MinWidth="{Binding ActualWidth, ElementName=ComboRoot}"
                                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                Margin="0,5,0,0" Padding="3"
                                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="9" ShadowDepth="2" Opacity="0.2" />
                                            </Border.Effect>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TextColorButton" Width="38" Height="36" Margin="1,0" Padding="5,3"
                        Style="{StaticResource TextPaletteButton}"
                        ToolTip="文字颜色"
                        Click="OnTextColorClick">
                    <Grid Width="26" Height="28">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top"
                                   FontSize="18" FontWeight="SemiBold" Text="A" />
                        <Border x:Name="TextColorPreview" Height="3" CornerRadius="1.5"
                                Margin="1,0" VerticalAlignment="Bottom" Background="White" />
                    </Grid>
                </Button>
                <Button x:Name="TextBackgroundButton" Width="38" Height="36" Margin="1,0" Padding="5,3"
                        Style="{StaticResource TextPaletteButton}"
                        ToolTip="文本框背景颜色" Click="OnTextBackgroundClick">
                    <Grid Width="26" Height="28">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,3,0,0"
                                   FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE790;" />
                        <Border x:Name="TextBackgroundPreview" Height="3" CornerRadius="1.5"
                                Margin="1,0" VerticalAlignment="Bottom" Background="Transparent" />
                    </Grid>
                </Button>
                <Border Width="1" Height="25" Margin="7,0" Background="{DynamicResource ToolbarBorderBrush}" />
                <Button x:Name="TextBoldButton" Width="38" Height="36" Margin="1,0" Padding="0"
                        Style="{StaticResource TextPaletteButton}" FontWeight="Bold" FontSize="17" Content="B"
                        ToolTip="粗体" Click="OnTextBoldClick" />
                <Button x:Name="TextItalicButton" Width="38" Height="36" Margin="1,0" Padding="0"
                        Style="{StaticResource TextPaletteButton}" FontStyle="Italic" FontWeight="Bold" FontSize="17" Content="I"
                        ToolTip="斜体" Click="OnTextItalicClick" />
                <Button x:Name="TextUnderlineButton" Width="38" Height="36" Margin="1,0" Padding="0"
                        Style="{StaticResource TextPaletteButton}"
                        ToolTip="下划线" Click="OnTextUnderlineClick">
                    <TextBlock FontSize="17" FontWeight="Bold" Text="U"
                               TextDecorations="Underline" />
                </Button>
                <Border Width="1" Height="25" Margin="7,0" Background="{DynamicResource ToolbarBorderBrush}" />
                <ComboBox x:Name="TextSizeCombo" Width="76" Height="36" Margin="1,0"
                          Style="{StaticResource TextPaletteCombo}"
                          IsEditable="False" IsTextSearchEnabled="True"
                          SelectionChanged="OnTextSizeChanged" />
                <ComboBox x:Name="TextFontCombo" Width="180" Height="36" Margin="3,0,1,0"
                          Style="{StaticResource TextPaletteCombo}"
                          IsEditable="False" IsTextSearchEnabled="True"
                          SelectionChanged="OnTextFontChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}"
                                       FontSize="14" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Width="1" Height="25" Margin="7,0,5,0" Background="{DynamicResource ToolbarBorderBrush}" />
                <Button x:Name="TextMoreButton" Width="38" Height="36" Margin="1,0" Padding="0"
                        Style="{StaticResource TextPaletteButton}" ToolTip="更多文字选项"
                        Click="OnTextMoreClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE70D;" />
                </Button>
            </StackPanel>
        </Border>

        <Popup x:Name="TextMorePopup" services:PopupTransitions.Enabled="True" Panel.ZIndex="210"
               Placement="Bottom" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="None">
            <Border Padding="6" TextElement.Foreground="{DynamicResource TextBrush}">
            <StackPanel>
                <Path x:Name="TextMoreArrowUp" Panel.ZIndex="1" Width="16" Height="8"
                      HorizontalAlignment="Center" Margin="0,0,0,-1"
                      Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness=".8"
                      Data="M0,8 L8,0 L16,8" />
                <Border Padding="7"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="11">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" />
                    </Border.Effect>
                    <StackPanel x:Name="TextMoreActions" Orientation="Horizontal">
                        <Button x:Name="CopyTextStyleButton" Width="38" Height="36" Padding="5"
                                Style="{StaticResource ModernButton}" ToolTip="复制文字样式" Click="OnCopyTextStyleClick">
                            <Path Width="24" Height="24" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M4,15 H2 V2 H14 V5 M6,6 H20 V22 H6 Z M9,11 V9 H17 V11 M13,9 V18 M11,18 H15" />
                        </Button>
                        <Button x:Name="PasteTextStyleButton" Width="38" Height="36" Padding="5" Margin="3,0,0,0"
                                Style="{StaticResource ModernButton}" ToolTip="粘贴文字样式" IsEnabled="False" Click="OnPasteTextStyleClick">
                            <Path Width="24" Height="24" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M8,4 H4 V22 H20 V4 H16 M8,2 H16 V6 H8 Z M8,12 V10 H16 V12 M12,10 V19 M10,19 H14" />
                        </Button>
                        <Border Width="1" Height="23" Background="{DynamicResource ControlBorderBrush}" Margin="8,0" />
                        <Button x:Name="ClearTextFormattingButton" Width="38" Height="36" Padding="5"
                                Style="{StaticResource ModernButton}" ToolTip="清除文字样式" Click="OnClearTextFormattingClick">
                            <Grid Width="24" Height="24">
                                <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,5 V3 H17 V5 M10,3 V15 M7,15 H11" />
                                <Path Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M11,16 L17,10 Q18,9 19,10 L22,13 Q23,14 22,15 L17,20 H15 Z M14,13 L20,18 M14,21 H23" />
                            </Grid>
                        </Button>
                        <Border Width="1" Height="23" Background="{DynamicResource ControlBorderBrush}" Margin="8,0" />
                        <Button x:Name="TextLinksButton" Width="38" Height="36" Padding="5"
                                Style="{StaticResource ModernButton}" ToolTip="注释网页与文件链接" Focusable="False"
                                AutomationProperties.Name="注释网页与文件链接" Click="OnTextLinksClick">
                            <Path Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M7,12 L12,7 M8,5 L11,2 C15,-2 22,5 18,9 L15,12 M12,15 L9,18 C5,22 -2,15 2,11 L5,8" />
                        </Button>
                    </StackPanel>
                </Border>
                <Path x:Name="TextMoreArrowDown" Panel.ZIndex="1" Width="16" Height="8"
                      HorizontalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"
                      Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness=".8"
                      Data="M0,0 L8,8 L16,0" />
            </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="DrawingPalette" Panel.ZIndex="110"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,18" Padding="8"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1" CornerRadius="13" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".18" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DrawingPenButton" Style="{StaticResource DrawingToolButton}"
                        ToolTip="画笔 (B)" Tag="Pen" Click="OnDrawingToolClick">
                    <Path Width="20" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" Data="M3,13 L13,3 L17,7 L7,17 L2,18 Z M11,5 L15,9 M3,13 L7,17" />
                </Button>
                <Button x:Name="DrawingShapesButton" Width="46" Style="{StaticResource DrawingToolButton}"
                        ToolTip="形状：直线、箭头、矩形、椭圆" Click="OnDrawingShapesClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="DrawingShapeIcon" Width="18" Height="18" Margin="0,0,7,0"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"
                              Data="M 9,1 A 8,8 0 1 1 9,17 A 8,8 0 1 1 9,1" />
                        <Path Width="6" Height="4" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M0,0 L3,3 L6,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="DrawingEraseButton" Style="{StaticResource DrawingToolButton}"
                        Margin="1,0,0,0"
                        ToolTip="橡皮擦 (E)" Tag="Eraser" Click="OnDrawingToolClick">
                    <Path Width="20" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" Data="M2,12 L11,3 L18,10 L10,18 L7,18 Z M6,8 L13,15 M7,18 L18,18" />
                </Button>
                <Button x:Name="DrawingEraserSizeButton" Style="{StaticResource DrawingToolButton}"
                        Width="16" Margin="0,0,1,0" ToolTip="橡皮擦大小" Click="OnDrawingEraserSizeClick">
                    <Path Width="6" Height="4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                          Data="M0,0 L3,3 L6,0" />
                </Button>
                <Border Width="1" Height="25" Margin="6,0" Background="{DynamicResource ToolbarBorderBrush}" />
                <Button x:Name="DrawingStrokeColorButton" Style="{StaticResource DrawingToolButton}"
                        ToolTip="笔画颜色" Click="OnDrawingStrokeColorClick">
                    <Grid Width="24" Height="27">
                        <Path Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7"
                              StrokeLineJoin="Round" Data="M2,13 L13,2 L17,6 L6,17 L1,18 Z M11,4 L15,8" />
                        <Border x:Name="DrawingStrokePreview" Height="3" CornerRadius="1.5"
                                VerticalAlignment="Bottom" Background="#FF55A6C9" />
                    </Grid>
                </Button>
                <Button x:Name="DrawingFillColorButton" Style="{StaticResource DrawingToolButton}"
                        ToolTip="形状填充颜色" Click="OnDrawingFillColorClick">
                    <Grid Width="24" Height="27">
                        <Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Data="M5,2 L14,11 L8,17 L1,10 L8,3 M2,10 L13,10 M16,13 C16,13 13,16 15,18 C17,20 20,17 16,13" />
                        <Border x:Name="DrawingFillPreview" Height="3" CornerRadius="1.5"
                                BorderThickness=".5" BorderBrush="#40000000"
                                VerticalAlignment="Bottom" Background="Transparent" />
                    </Grid>
                </Button>
                <Button x:Name="DrawingSettingsButton" Width="46" Style="{StaticResource DrawingToolButton}"
                        ToolTip="线条：粗细、透明度、实线与虚线" Click="OnDrawingSettingsClick">
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="DrawingLineStyleIcon" Width="18" Height="18">
                            <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M1,3 H17" />
                            <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M1,9 H17" />
                            <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="3" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M1,15 H17" />
                        </Grid>
                        <Path Width="6" Height="4" Margin="7,0,0,0" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Data="M0,0 L3,3 L6,0" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="25" Margin="6,0" Background="{DynamicResource ToolbarBorderBrush}" />
                <Button x:Name="DrawingCloseButton" Style="{StaticResource DrawingToolButton}"
                        ToolTip="完成绘制 (Esc)" Click="OnSelectToolClick">
                    <Path Width="14" Height="14" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1,1 L13,13 M13,1 L1,13" />
                </Button>
            </StackPanel>
        </Border>

        <Popup x:Name="DrawingShapesPopup" services:PopupTransitions.Enabled="True" Placement="Top"
               PlacementTarget="{Binding ElementName=DrawingShapesButton}"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
            <Border Padding="6" TextElement.Foreground="{DynamicResource TextBrush}">
            <StackPanel>
                <Border Padding="6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="11">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DrawingLineButton" Style="{StaticResource DrawingToolButton}" Tag="Line" ToolTip="直线" Click="OnDrawingToolClick">
                            <Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" Data="M2,16 L16,2" />
                        </Button>
                        <Button x:Name="DrawingArrowButton" Style="{StaticResource DrawingToolButton}" Tag="Arrow" ToolTip="箭头" Click="OnDrawingToolClick">
                            <Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" Data="M2,16 L16,2 M7,2 L16,2 L16,11" />
                        </Button>
                        <Button x:Name="DrawingRectangleButton" Style="{StaticResource DrawingToolButton}" Tag="Rectangle" ToolTip="矩形" Click="OnDrawingToolClick">
                            <Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" Data="M2,3 H16 V15 H2 Z" />
                        </Button>
                        <Button x:Name="DrawingEllipseButton" Style="{StaticResource DrawingToolButton}" Tag="Ellipse" ToolTip="椭圆" Click="OnDrawingToolClick">
                            <Ellipse Width="17" Height="17" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" />
                        </Button>
                    </StackPanel>
                </Border>
                <Path x:Name="DrawingShapesArrow" Width="16" Height="8" Margin="0,-1,0,0" HorizontalAlignment="Center"
                      Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness=".8" Data="M0,0 L8,8 L16,0" />
            </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="DrawingEraserPopup" services:PopupTransitions.Enabled="True" Placement="Top"
               PlacementTarget="{Binding ElementName=DrawingEraserSizeButton}"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
            <Border Padding="6" TextElement.Foreground="{DynamicResource TextBrush}">
            <StackPanel>
                <Border Width="234" Padding="14,11" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="11">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="橡皮擦直径" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="EraserDiameterText" Text="28"
                                     Style="{StaticResource DrawingNumberInput}"
                                     GotKeyboardFocus="OnDrawingNumericGotFocus"
                                     PreviewKeyDown="OnDrawingNumericKeyDown"
                                     LostKeyboardFocus="OnDrawingNumericLostFocus" />
                            <TextBlock Text="px" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="EraserDiameterSlider" Margin="0,9,0,0"
                                Style="{StaticResource DrawingSlider}"
                                Minimum="8" Maximum="160" Value="28" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True" ValueChanged="OnEraserDiameterChanged" />
                    </StackPanel>
                </Border>
                <Path x:Name="DrawingEraserArrow" Width="16" Height="8" Margin="0,-1,0,0" HorizontalAlignment="Center"
                      Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness=".8" Data="M0,0 L8,8 L16,0" />
            </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="DrawingSettingsPopup" services:PopupTransitions.Enabled="True" Placement="Top"
               PlacementTarget="{Binding ElementName=DrawingSettingsButton}"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
            <Border Padding="6" TextElement.Foreground="{DynamicResource TextBrush}">
            <StackPanel>
                <Border Width="234" Padding="14,11" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="11">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="粗细" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="DrawingThicknessText" Text="4"
                                     Style="{StaticResource DrawingNumberInput}"
                                     GotKeyboardFocus="OnDrawingNumericGotFocus"
                                     PreviewKeyDown="OnDrawingNumericKeyDown"
                                     LostKeyboardFocus="OnDrawingNumericLostFocus" />
                            <TextBlock Text="px" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="DrawingThicknessSlider" Margin="0,8,0,12"
                                Style="{StaticResource DrawingSlider}"
                                Minimum="1" Maximum="48" Value="4" IsMoveToPointEnabled="True"
                                ValueChanged="OnDrawingStyleChanged" />
                        <DockPanel>
                            <TextBlock Text="透明度" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="DrawingOpacityText" Text="100"
                                     Style="{StaticResource DrawingNumberInput}"
                                     GotKeyboardFocus="OnDrawingNumericGotFocus"
                                     PreviewKeyDown="OnDrawingNumericKeyDown"
                                     LostKeyboardFocus="OnDrawingNumericLostFocus" />
                            <TextBlock Text="%" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="DrawingOpacitySlider" Margin="0,8,0,10"
                                Style="{StaticResource DrawingSlider}"
                                Minimum=".05" Maximum="1" Value="1" IsMoveToPointEnabled="True"
                                ValueChanged="OnDrawingStyleChanged" />
                         <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="DrawingSolidButton" Width="62" Style="{StaticResource DrawingToolButton}"
                                    Tag="Solid" ToolTip="实线" Click="OnDrawingDashClick">
                                <Path Width="42" Height="12" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Data="M0,6 H42" />
                            </Button>
                            <Button x:Name="DrawingDashButton" Width="62" Style="{StaticResource DrawingToolButton}"
                                    Tag="Dashed" ToolTip="虚线" Click="OnDrawingDashClick">
                                <Path Width="42" Height="12" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                      StrokeDashArray="3,2" Data="M0,6 H42" />
                            </Button>
                            <Button x:Name="DrawingCurveArrowButton" Width="62" Style="{StaticResource DrawingToolButton}"
                                    Tag="Arrow" ToolTip="箭头：沿画笔轨迹绘制" Click="OnDrawingDashClick">
                                <Path Width="42" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,17 C7,0 31,0 38,13 M29,10 L38,13 L40,4" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Path x:Name="DrawingSettingsArrow" Width="16" Height="8" Margin="0,-1,0,0" HorizontalAlignment="Center"
                      Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness=".8" Data="M0,0 L8,8 L16,0" />
            </StackPanel>
            </Border>
        </Popup>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Padding="8,4" Background="#99151619" CornerRadius="6">
            <TextBlock x:Name="BoardStatus" Foreground="#CCFFFFFF" FontSize="11"
                       Text="滚轮缩放 · 中键或 Space 拖动画布 · Ctrl 多选" />
        </Border>
    </Grid>
    </Border>
    </Grid>
</Window>
