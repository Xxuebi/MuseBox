                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".2" /></Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="边框粗细" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox x:Name="GroupBorderThicknessText" Text="1.2"
