<Window x:Class="ScreenshotCollector.EyedropperOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" Background="#01000000"
        Cursor="Cross" PreviewKeyDown="OnPreviewKeyDown"
        MouseMove="OnOverlayMouseMove" MouseLeftButtonDown="OnOverlayMouseLeftButtonDown"
        MouseRightButtonDown="OnOverlayMouseRightButtonDown">
    <Canvas x:Name="OverlayCanvas" Background="#01000000">
        <Border x:Name="SampleBadge" Width="116" Height="42" Padding="6"
                Background="#EEFFFFFF" BorderBrush="#33000000"
                BorderThickness="1" CornerRadius="7" IsHitTestVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SampleSwatch" Margin="0,0,7,0" CornerRadius="4"
                        BorderBrush="#33000000" BorderThickness="1" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SampleText" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock FontSize="9" Foreground="#88000000" Text="点击吸色 · Esc 取消" />
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
