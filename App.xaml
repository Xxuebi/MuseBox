<Application x:Class="ScreenshotCollector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ScreenshotCollector.Services"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
        <services:SwitchValueConverter x:Key="SwitchValueConverter" />
        <SolidColorBrush x:Key="PageBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#E4000000" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9E000000" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#26000000" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFFBFBFB" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFE2E2E2" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FFD8EBF9" />
        <SolidColorBrush x:Key="SwitchOffBrush" Color="#FF8B8B8B" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#FFF7F7F7" />
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#30000000" />
        <SolidColorBrush x:Key="ToolbarTextBrush" Color="#E6000000" />
        <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#FFE8E8E8" />
        <SolidColorBrush x:Key="ToolbarPressedBrush" Color="#FFD8D8D8" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC42B1C" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#FFF8F8F8" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#33000000" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#7A7A7A" />

        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate><Grid /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionChrome" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionChrome" Property="Background" Value="#FFC42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemedWindow" TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PageBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                                        GlassFrameThickness="0" CornerRadius="14"
                                        UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border x:Name="ThemedWindowChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="ThemedTitleBar" Background="{DynamicResource TitleBarBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="0,0,0,1" CornerRadius="14,14,0,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="MinimizeCaptionButton" Style="{StaticResource CaptionButton}"
                                                    Command="{x:Static services:ThemedWindowCommands.Minimize}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="最小化" AutomationProperties.Name="最小化">
                                                <Path Width="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2" Data="M0,0 H10" />
                                            </Button>
                                            <Button x:Name="MaximizeCaptionButton" Style="{StaticResource CaptionButton}"
                                                    Command="{x:Static services:ThemedWindowCommands.ToggleMaximize}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="最大化" AutomationProperties.Name="最大化">
                                                <Rectangle Width="10" Height="10"
                                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           StrokeThickness="1.2" />
                                            </Button>
                                            <Button x:Name="CloseCaptionButton" Tag="Close" Style="{StaticResource CloseCaptionButton}"
                                                    Command="{x:Static services:ThemedWindowCommands.Close}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="关闭" AutomationProperties.Name="关闭">
                                                <Path Width="11" Height="11"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.35" StrokeStartLineCap="Round"
                                                      Data="M0,0 L11,11 M11,0 L0,11" />
                                            </Button>
                                        </StackPanel>
                                        <Image DockPanel.Dock="Left" Width="20" Height="20" Margin="12,0,8,0"
                                               Source="/MuseBox;component/Assets/app-icon.ico" />
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                                   FontSize="13" Text="{TemplateBinding Title}"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                </Border>
                                <AdornerDecorator Grid.Row="1">
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ResizeMode" Value="NoResize">
                                <Setter TargetName="MinimizeCaptionButton" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MaximizeCaptionButton" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="ResizeMode" Value="CanMinimize">
                                <Setter TargetName="MaximizeCaptionButton" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="WindowState" Value="Maximized">
                                <Setter TargetName="ThemedWindowChrome" Property="CornerRadius" Value="0" />
                                <Setter TargetName="ThemedTitleBar" Property="CornerRadius" Value="0" />
                                <Setter TargetName="MaximizeCaptionButton" Property="ToolTip" Value="还原" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="ToolTipChrome" Margin="6" Padding="{TemplateBinding Padding}" CornerRadius="9"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="1" Opacity=".14" /></Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources><Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="RoundedMenuItem" TargetType="MenuItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="MenuRow" Background="Transparent" CornerRadius="7" Padding="9,7" Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="23" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Margin="14,0,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" />
                                <Path x:Name="MenuArrow" Grid.Column="3" Visibility="Collapsed" Width="5" Height="8"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"
                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Data="M1,1 L4,4 L1,7" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" services:PopupTransitions.Enabled="True"
                               IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" HorizontalOffset="2">
                            <Border Margin="6" Padding="4" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity=".17" /></Border.Effect>
                                <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource SubtleBrush}" /></Trigger>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="MenuArrow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuRow" Property="Opacity" Value=".4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RoundedContextMenu" TargetType="ContextMenu">
            <Setter Property="services:PopupTransitions.Enabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuChrome" Margin="7" Padding="4" MinWidth="164"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="11">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity=".17" /></Border.Effect>
                        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource RoundedMenuItem}" />
                <Style TargetType="Separator">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="9,4" Background="{DynamicResource ControlBorderBrush}" />
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="23" />
            <Setter Property="services:SwitchAnimation.Enabled" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SwitchOffBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border Background="{DynamicResource SwitchOffBrush}" CornerRadius="12" />
                            <Border x:Name="TrackOn" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="12"
                                    Opacity="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource SwitchValueConverter}, ConverterParameter=1}" />
                            <Ellipse Width="17" Height="17" Margin="3"
                                     HorizontalAlignment="Left" Fill="White">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate"
                                                        X="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent},
                                                                    Converter={StaticResource SwitchValueConverter}, ConverterParameter=19}" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#19000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
