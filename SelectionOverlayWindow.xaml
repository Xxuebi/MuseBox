<Window x:Class="ScreenshotCollector.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        PreviewKeyDown="OnPreviewKeyDown"
        Title="选择截图区域">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Fill" SnapsToDevicePixels="True" />
        <Canvas x:Name="SelectionSurface"
                Background="Transparent"
                ClipToBounds="True"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseLeftButtonUp"
                MouseRightButtonDown="OnMouseRightButtonDown">
            <Rectangle x:Name="TopShade" Fill="#99000000" />
            <Rectangle x:Name="BottomShade" Fill="#99000000" />
            <Rectangle x:Name="LeftShade" Fill="#99000000" />
            <Rectangle x:Name="RightShade" Fill="#99000000" />
            <Rectangle x:Name="SelectionBorder"
                       Visibility="Collapsed"
                       Stroke="#FFFFFFFF"
                       StrokeThickness="2"
                       Fill="Transparent">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="5"
                                      ShadowDepth="0"
                                      Opacity="0.85" />
                </Rectangle.Effect>
            </Rectangle>
            <Border x:Name="GuideBadge"
                    Canvas.Left="20"
                    Canvas.Top="20"
                    Padding="12,7"
                    Background="#D9202020"
                    CornerRadius="7"
                    IsHitTestVisible="False">
                <TextBlock x:Name="GuideText"
                           Foreground="White"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           Text="拖动鼠标框选区域 · Esc 或右键取消" />
            </Border>
        </Canvas>
    </Grid>
</Window>
