<Window x:Class="ScreenshotCollector.CustomColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ScreenshotCollector.Services"
        Title="选择颜色" Width="360" Height="638"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="Transparent" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H8 V8 H0 Z" />
                    <GeometryDrawing Brush="#FFD7D7D7" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="RoundSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#88000000" StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome" Margin="2" Padding="9,6"
                                Background="Transparent" CornerRadius="6">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid>
                            <Border x:Name="MenuChrome" MinWidth="116" Padding="4" Margin="10"
                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="9">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteSwatchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchChrome" Padding="1" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchChrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="SwatchChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwatchChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormatComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Margin="1" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#220067C0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormatComboStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FormatComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="FormatComboRoot">
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome" Background="{TemplateBinding Background}"
                                                CornerRadius="7">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,25,0"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Width="8" Height="5" Margin="0,0,9,0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 0 0 L 4 4 L 8 0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" services:PopupTransitions.Enabled="True" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, ElementName=FormatComboRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0" Padding="3"
                                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PickerChrome" Background="{DynamicResource PageBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1" CornerRadius="11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.24" />
        </Border.Effect>
        <Grid Margin="18,12,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="12" />
                <RowDefinition Height="280" />
                <RowDefinition Height="12" />
                <RowDefinition Height="28" />
                <RowDefinition Height="8" />
                <RowDefinition Height="22" />
                <RowDefinition Height="9" />
                <RowDefinition Height="34" />
                <RowDefinition Height="10" />
                <RowDefinition Height="70" />
                <RowDefinition Height="14" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleDragRegion" MinHeight="46" Margin="-8,-4,-8,0"
                  Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock x:Name="PickerTitleText" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Text="选择颜色" />
                <Button Width="28" Height="28" MinHeight="0" Padding="0"
                        HorizontalAlignment="Right" Style="{StaticResource ModernButton}"
                        ToolTip="取消并关闭" Click="OnCloseClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <Border x:Name="HueBase" Grid.Row="2" Width="280" Height="280"
                    HorizontalAlignment="Center" ClipToBounds="True" CornerRadius="5"
                    BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                <Grid>
                    <Border x:Name="PureHueLayer" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="Black" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="SaturationValueCanvas" Background="Transparent"
                            MouseLeftButtonDown="OnSaturationValueMouseDown"
                            MouseMove="OnSaturationValueMouseMove"
                            MouseLeftButtonUp="OnPickerMouseUp">
                        <Ellipse x:Name="SaturationValueMarker" Width="15" Height="15"
                                 Stroke="#88000000" StrokeThickness="1.5" Fill="White"
                                 IsHitTestVisible="False" />
                    </Canvas>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="HueTrack" Width="280" Margin="0,4,0,4"
                      MouseLeftButtonDown="OnHueMouseDown"
                      MouseMove="OnHueMouseMove"
                      MouseLeftButtonUp="OnPickerMouseUp">
                    <Border CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset=".1667" />
                                <GradientStop Color="#FF00FF00" Offset=".3333" />
                                <GradientStop Color="#FF00FFFF" Offset=".5" />
                                <GradientStop Color="#FF0000FF" Offset=".6667" />
                                <GradientStop Color="#FFFF00FF" Offset=".8333" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse x:Name="HueMarker" Width="15" Height="15"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="White" Stroke="#88000000" StrokeThickness="1.5"
                             IsHitTestVisible="False" />
                </Grid>
                <Button x:Name="EyedropperButton" Grid.Column="1" Width="28" Height="28"
                        HorizontalAlignment="Right"
                        MinHeight="0" Padding="4" Style="{StaticResource ModernButton}"
                        ToolTip="从屏幕吸取颜色" Click="OnEyedropperClick">
                    <Viewbox x:Name="EyedropperGlyph" Width="13" Height="13" Stretch="Uniform">
                        <Canvas Width="18" Height="18">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M10,1 L17,8 M12,3 L4,11 L2,17 L8,15 L16,7" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="AlphaTrack" Width="280" Margin="0,2,0,2" ClipToBounds="True" Cursor="Hand"
                      PreviewMouseLeftButtonDown="OnAlphaMouseDown"
                      PreviewMouseMove="OnAlphaMouseMove"
                      PreviewMouseLeftButtonUp="OnPickerMouseUp">
                    <Border Background="{StaticResource CheckerBrush}" CornerRadius="8" />
                    <Border x:Name="AlphaColorTrack" CornerRadius="8" />
                    <Slider x:Name="AlphaSlider" Style="{StaticResource RoundSlider}"
                             Minimum="0" Maximum="100" Value="100"
                             Focusable="False" IsHitTestVisible="False"
                             IsMoveToPointEnabled="True" ValueChanged="OnAlphaValueChanged" />
                </Grid>
                <TextBlock x:Name="AlphaText" Grid.Column="1" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="100%" />
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ColorFormatCombo" Margin="0,0,6,0"
                          Style="{StaticResource FormatComboStyle}"
                          SelectedIndex="0" SelectionChanged="OnColorFormatChanged">
                    <ComboBoxItem Content="HEX" />
                    <ComboBoxItem Content="RGB" />
                    <ComboBoxItem Content="HSB" />
                    <ComboBoxItem Content="LAB" />
                    <ComboBoxItem Content="CSS" />
                </ComboBox>
                <Border Grid.Column="1" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <TextBox x:Name="HexTextBox" Padding="8,0" BorderThickness="0"
                             Background="Transparent" VerticalContentAlignment="Center"
                             TextChanged="OnHexTextChanged" />
                </Border>
                <Button x:Name="CopyColorButton" Grid.Column="2"
                        Width="30" Height="30" MinHeight="0" Margin="4,0,0,0"
                        Padding="4" Style="{StaticResource ModernButton}"
                        ToolTip="复制颜色值" Click="OnCopyHexClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8C8;" />
                </Button>
            </Grid>

            <Popup x:Name="CopyFeedbackPopup" services:PopupTransitions.Enabled="True"
                   PlacementTarget="{Binding ElementName=CopyColorButton}"
                   Placement="Top" VerticalOffset="-6"
                   AllowsTransparency="True" StaysOpen="True"
                   PopupAnimation="None" IsHitTestVisible="False">
                <Border Padding="9,5" Background="#EA202124"
                        CornerRadius="7">
                    <TextBlock Foreground="White" FontSize="12" Text="已复制" />
                </Border>
            </Popup>

            <Border x:Name="SavedColorPalette" Grid.Row="10" Padding="7,6"
                    Background="{StaticResource SubtleBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="9">
                <ItemsControl x:Name="SavedColorList" Width="280" Height="56"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="280" Height="56"
                                       ItemWidth="28" ItemHeight="28" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="SwatchButton" Width="28" Height="28" MinHeight="0" Padding="0"
                                    Tag="{Binding}" Style="{StaticResource PaletteSwatchButtonStyle}"
                                    ToolTip="左键选取，右键删除"
                                    Click="OnSavedColorClick"
                                    ContextMenuOpening="OnSavedColorContextMenuOpening">
                                <Grid>
                                    <Border x:Name="Swatch" Width="22" Height="22" CornerRadius="4"
                                             Background="{Binding OpaqueBrush}"
                                             BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                            ClipToBounds="True" SnapsToDevicePixels="True">
                                        <Grid x:Name="AlphaHalf" Width="10"
                                              HorizontalAlignment="Right">
                                            <Border Background="{StaticResource CheckerBrush}" />
                                            <Border Background="{Binding ActualBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="AddTile" Width="22" Height="22" Visibility="Collapsed"
                                            Background="{DynamicResource InputBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Text="&#xE710;" />
                                    </Border>
                                </Grid>
                                <Button.ContextMenu>
                                    <ContextMenu services:PopupTransitions.Enabled="True" Style="{StaticResource PaletteContextMenuStyle}">
                                        <MenuItem Style="{StaticResource PaletteMenuItemStyle}"
                                                  Click="OnDeleteSavedColorClick">
                                            <MenuItem.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="13" Height="13"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  Data="M3,4 H13 M6,4 V2 H10 V4 M4.5,5.5 V14 H11.5 V5.5 M7,7 V12 M9,7 V12" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1" Margin="2,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="删除色块" />
                                                </Grid>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasTransparency}" Value="False">
                                    <Setter TargetName="AlphaHalf" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                    <Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="AddTile" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SwatchButton" Property="ToolTip" Value="保存当前颜色" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel x:Name="ColorDialogButtons" Grid.Row="12"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ColorCancelButton" MinWidth="92" Margin="0,0,14,0"
                        Style="{StaticResource ModernButton}"
                        Content="取消" Click="OnCancelClick" />
                <Button x:Name="ColorApplyButton" MinWidth="92" Style="{StaticResource AccentButton}"
                        Content="应用" Click="OnApplyClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
