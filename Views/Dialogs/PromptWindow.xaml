<Window x:Class="ScreenshotCollector.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="OnPromptKeyDown">
    <Border x:Name="PromptChrome" Margin="10" Padding="22,18" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity=".17" /></Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,15" MouseLeftButtonDown="OnHeaderDrag">
                <Button DockPanel.Dock="Right" Width="28" Height="28" MinHeight="0" Padding="0" Content="×"
                        Style="{StaticResource ModernButton}" BorderThickness="0" Background="Transparent"
                        ToolTip="关闭" Click="OnCancelClick" />
                <TextBlock x:Name="PromptTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="PromptMessage" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="PromptAlternative" MinWidth="80" Margin="0,0,10,0" Visibility="Collapsed"
                        Style="{StaticResource ModernButton}" Click="OnAlternativeClick" />
                <Button x:Name="PromptCancel" MinWidth="80" Margin="0,0,10,0" Content="取消"
                        Style="{StaticResource ModernButton}" Click="OnCancelClick" />
                <Button x:Name="PromptConfirm" MinWidth="90" Content="确定"
                        Style="{StaticResource AccentButton}" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
