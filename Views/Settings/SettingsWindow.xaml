<Window x:Class="ScreenshotCollector.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindow}"
        Title="MuseBox 设置" Width="780" Height="590" MinWidth="700" MinHeight="520"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="SideTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="178" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="10"
                                Cursor="Hand" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Chrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />

                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="CompactShortcutClear" TargetType="Button" BasedOn="{StaticResource IconOnlyButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="CompactShortcutInput" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppearanceChoice" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceChrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsCategories" Grid.Row="2" TabStripPlacement="Left" SelectionChanged="OnSettingsCategoryChanged"
                    Background="Transparent" BorderThickness="0"
                    FocusVisualStyle="{x:Null}"
                    Foreground="{DynamicResource TextBrush}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SideTabItem}" />
            </TabControl.Resources>
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsPresenter Margin="0,0,12,0"
                                        KeyboardNavigation.TabNavigation="Once" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="GeneralSettingsTab">
                <TabItem.Header><StackPanel Orientation="Horizontal">
                    <TextBlock Width="26" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE774;" />
                    <TextBlock Text="常规" />
                </StackPanel></TabItem.Header>
                <ScrollViewer Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="16,6" VerticalAlignment="Top" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                        <Grid Height="44" Background="Transparent" ToolTip="关闭后，小窗卡片只显示抽屉名称；不改变抽屉编号">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="显示抽屉字母标识" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="ShowDrawerLettersToggle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SwitchStyle}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ControlBorderBrush}" />
                        <Grid Height="44" Background="Transparent" ToolTip="开启后，截图按钮和快捷键调用 Windows 截图；关闭使用内置框选">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="使用系统自带截图" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="UseSystemScreenshotToggle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SwitchStyle}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ControlBorderBrush}" />
                        <Grid Height="44" Background="Transparent" ToolTip="在系统高负载或硬件加速不稳定时，使用更稳定的绘制方式">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="兼容渲染模式" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="CompatibleRenderingToggle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SwitchStyle}" />
                        </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AppearanceSettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="26" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE790;" />
                        <TextBlock Text="外观和语言" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top">
                        <Border Padding="18" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="外观模式" />
                                <TextBlock Margin="0,5,0,14" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="应用于小窗、设置、画板工具栏以及画板内的所有菜单" />
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="LightAppearanceRadio" GroupName="Appearance"
                                                 Style="{StaticResource AppearanceChoice}"
                                                 Background="#FFF8F8F8" Foreground="#FF1E1F22" Content="白天" />
                                    <RadioButton x:Name="DarkAppearanceRadio" GroupName="Appearance"
                                                 Style="{StaticResource AppearanceChoice}"
                                                 Background="#FF25262A" Foreground="#FFF4F4F4" Content="黑夜" />
                                    <RadioButton x:Name="SystemAppearanceRadio" GroupName="Appearance"
                                                 Style="{StaticResource AppearanceChoice}" Margin="0"
                                                 AutomationProperties.Name="跟随系统外观"
                                                 ToolTip="跟随 Windows 应用模式"
                                                 Content="系统 · 白天" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Padding="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="应用语言" />
                                </StackPanel>
                                <Border Grid.Column="1" MinHeight="38" Padding="12,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="7">
                                    <TextBlock x:Name="LanguageValueText" VerticalAlignment="Center"
                                               Text="简体中文" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FileIntegrationTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="26" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE8A5;" />
                        <TextBlock Text="文件集成" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border VerticalAlignment="Top" Padding="18"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Windows 资源管理器" />
                            <TextBlock Margin="0,5,0,17" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="按当前用户安装，不需要管理员权限。程序移动到其他文件夹后可在这里修复路径。" />

                            <Grid MinHeight="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" Text="文件关联 (.mubo)" />
                                    <TextBlock x:Name="FileAssociationStatusText" Margin="0,3,12,0" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" Text="正在检查…" />
                                </StackPanel>
                                <Button x:Name="RepairFileAssociationButton" Grid.Column="1" MinWidth="68"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Style="{StaticResource ModernButton}" Content="修复"
                                        Click="OnRepairFileAssociationClick" />
                                <Button x:Name="UninstallFileAssociationButton" Grid.Column="2" MinWidth="68"
                                        VerticalAlignment="Center" Style="{StaticResource ModernButton}"
                                        Content="卸载" Click="OnUninstallFileAssociationClick" />
                            </Grid>

                            <Border Height="1" Margin="0,10" Background="{StaticResource ControlBorderBrush}" />

                            <Grid MinHeight="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" Text="资源管理器缩略图 (.mubo)" />
                                    <TextBlock x:Name="SceneThumbnailStatusText" Margin="0,3,12,0" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" Text="正在检查…" />
                                </StackPanel>
                                <Button x:Name="RepairSceneThumbnailButton" Grid.Column="1" MinWidth="68"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Style="{StaticResource ModernButton}" Content="修复"
                                        Click="OnRepairSceneThumbnailClick" />
                                <Button x:Name="UninstallSceneThumbnailButton" Grid.Column="2" MinWidth="68"
                                        VerticalAlignment="Center" Style="{StaticResource ModernButton}"
                                        Content="卸载" Click="OnUninstallSceneThumbnailClick" />
                            </Grid>
                            <TextBlock x:Name="ShellIntegrationFeedback" Margin="0,16,0,0" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="新保存或再次保存的场景会携带画板总览缩略图。" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SaveLoadSettingsTab">
                <TabItem.Header><StackPanel Orientation="Horizontal">
                    <TextBlock Width="26" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74E;" />
                    <TextBlock Text="保存和加载" />
                </StackPanel></TabItem.Header>
                <ScrollViewer Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock x:Name="StorageHeading" Text="画板保存路径" FontSize="14" FontWeight="SemiBold"
                                           Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False"
                                           ToolTip="更改后重启生效；切换到空目录时会迁移现有画板" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="StoragePathTextBox" MinHeight="32" Padding="9,0" VerticalContentAlignment="Center"
                                             Style="{StaticResource CompactShortcutInput}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="56" Padding="8,4" Style="{StaticResource ModernButton}" Content="默认" Click="OnDefaultStorageClick" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" MinWidth="56" Padding="8,4" Style="{StaticResource ModernButton}" Content="浏览…" Click="OnBrowseStorageClick" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,8,0,0" Padding="16,6" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <Grid Height="44" Background="Transparent" ToolTip="定时保存已绑定场景文件的修改；未保存过的画板不会自动创建文件">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动保存" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="AutoSaveToggle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SwitchStyle}"
                                                  Checked="OnAutoSaveToggleChanged" Unchecked="OnAutoSaveToggleChanged" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource ControlBorderBrush}" />
                                <Grid x:Name="AutoSaveIntervalRow" Height="44" Background="Transparent" ToolTip="自动保存间隔，可设置 1–120 分钟" ToolTipService.ShowOnDisabled="True">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动保存间隔" FontSize="14" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="AutoSaveIntervalInput" Width="64" Height="30" TextAlignment="Center" Style="{StaticResource CompactShortcutInput}" ToolTip="输入 1–120 的整数" />
                                        <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource ControlBorderBrush}" />
                                <Grid Height="44" Background="Transparent" ToolTip="每个画板保留 1–500 步；默认 100 步，越多越占内存">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="撤回步骤上限" FontSize="14" VerticalAlignment="Center" />
                                    <TextBox x:Name="UndoStepLimitInput" Grid.Column="1" Width="88" Height="30" VerticalAlignment="Center"
                                             TextAlignment="Center" Style="{StaticResource CompactShortcutInput}" ToolTip="输入 1–500 的整数" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ShortcutSettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="26" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE765;" />
                        <TextBlock Text="键盘快捷键" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,6,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RestoreShortcutDefaultsButton" Style="{StaticResource ModernButton}" MinHeight="28" MinWidth="72"
                                        Padding="8,3" FontSize="12" Content="恢复默认" Click="OnRestoreShortcutDefaultsClick" />
                                <Button x:Name="DisableAllShortcutsButton" Style="{StaticResource ModernButton}" MinHeight="28" MinWidth="116"
                                        Margin="5,0,0,0" Padding="8,3" FontSize="12" Content="禁用所有快捷键" Click="OnDisableAllShortcutsClick" />
                            </StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="键盘快捷键" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="ShortcutSearchBox" Height="30" Padding="9,0"
                                     Style="{StaticResource CompactShortcutInput}"
                                     ToolTip="搜索功能、分组或快捷键" TextChanged="OnShortcutSearchChanged" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}"
                                       Text="搜索功能、分组或快捷键">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ShortcutSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Text="点击按键框直接录入组合键，同一按键不能重复分配" />
                        <TextBlock x:Name="ShortcutConflictText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerTextBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <ScrollViewer x:Name="ShortcutScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <Border x:Name="GlobalHotkeyCard" Margin="0,0,0,6" Padding="8,4"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="#10000000" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="全局" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="框选截图" FontSize="12" VerticalAlignment="Center" />
                                    <Border x:Name="HotkeyInputBorder" Grid.Column="2" Height="26"
                                            Margin="0,0,6,0" Padding="7,0"
                                            Background="{DynamicResource InputBrush}"
                                            BorderBrush="{StaticResource ControlBorderBrush}"
                                            BorderThickness="1" CornerRadius="5">
                                        <TextBox x:Name="HotkeyInputTextBox" FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Background="Transparent" BorderThickness="0"
                                                 IsReadOnly="True" Cursor="Hand"
                                                 PreviewMouseLeftButtonDown="OnHotkeyInputMouseDown"
                                                 GotKeyboardFocus="OnHotkeyInputGotFocus"
                                                 LostKeyboardFocus="OnHotkeyInputLostFocus"
                                                 PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                                    </Border>
                                    <ToggleButton x:Name="HotkeyToggle" Grid.Column="3"
                                                  VerticalAlignment="Center"
                                                  ToolTip="启用全局截图快捷键"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="OnHotkeyToggleChanged"
                                                  Unchecked="OnHotkeyToggleChanged" />
                                    <Button Grid.Column="4" Style="{StaticResource CompactShortcutClear}"
                                            ToolTip="清除快捷键" Click="OnClearGlobalHotkeyClick">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Text="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="ShortcutGroupList" ItemsSource="{Binding ShortcutGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="8,3"
                                                Background="{DynamicResource CardBrush}" CornerRadius="8"
                                                BorderBrush="#10000000" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,8,5,0" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DisplayName}" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Shortcuts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="31">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="94" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="26" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" FontSize="12"
                                                                           Text="{Binding DisplayName}" />
                                                                <TextBox Grid.Column="1" Margin="0,0,5,0"
                                                                         Style="{StaticResource CompactShortcutInput}"
                                                                         IsReadOnly="True" Cursor="Hand"
                                                                         Tag="{Binding Id}" Text="{Binding Gesture}"
                                                                         ToolTip="{Binding ConflictMessage}"
                                                                         GotKeyboardFocus="OnBoardShortcutInputFocus"
                                                                         PreviewKeyDown="OnBoardShortcutKeyDown" />
                                                                <Button Grid.Column="2"
                                                                        Style="{StaticResource CompactShortcutClear}"
                                                                        Tag="{Binding Id}" ToolTip="清除快捷键"
                                                                        Click="OnClearBoardShortcutClick">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="13" Text="&#xE74D;" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoShortcutResults" Text="未找到匹配的快捷键" Margin="8,16"
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="AboutSettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="26" FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE946;" />
                        <TextBlock Text="关于" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border VerticalAlignment="Top" Padding="22"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="AboutAppIcon" Width="64" Height="64" Margin="0,0,16,0"
                                       Source="/MuseBox;component/Assets/app-icon.ico" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutProductName" FontSize="20"
                                               FontWeight="SemiBold" Text="MuseBox" />
                                    <TextBlock x:Name="AboutChineseSubtitle" Margin="0,3,0,0"
                                               FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="灵感收集器" />
                                    <TextBlock x:Name="AppVersionText" Margin="0,5,0,0" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Margin="0,18" Background="{DynamicResource ControlBorderBrush}" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="收集素材，整理灵感" />
                            <TextBlock Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="接收截图、剪贴板和本地图片，在自由画板中添加文字与绘制，通过组合和图层整理素材。" />
                            <TextBlock Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="支持 GIF、图片编辑、排列与网格吸附；使用 .mubo 保存可继续编辑的场景，或批量导出图片与合成 PNG。" />
                            <Border Height="1" Margin="0,16" Background="{DynamicResource ControlBorderBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="开发者" />
                                <TextBlock Grid.Column="1" FontSize="12" Text="Xxuebi" />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="许可证" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" FontSize="12" Text="MIT · 开源软件" />
                                <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="运行环境" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" FontSize="12"
                                           TextWrapping="Wrap" Text="Windows 10 / 11 · .NET 8 Desktop Runtime" />
                            </Grid>
                            <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="素材、设置和画板数据保存在本机；MuseBox 不会主动上传你的素材。" />
                            <Border Height="1" Margin="0,16" Background="{DynamicResource ControlBorderBrush}" />
                            <Button x:Name="AboutGitHubButton" Style="{StaticResource ModernButton}"
                                    Tag="project" Click="OnAboutLinkClick"
                                    ToolTip="在浏览器中打开 GitHub 项目主页"
                                    Content="GitHub · Xxuebi / MuseBox" />
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource ModernButton}" Margin="0,0,4,0"
                                        Tag="releases" Click="OnAboutLinkClick" Content="下载便携版" />
                                <Button Style="{StaticResource ModernButton}" Margin="4,0,0,0"
                                        Tag="issues" Click="OnAboutLinkClick" Content="问题反馈" />
                            </UniformGrid>
                            <TextBlock Margin="0,12,0,0" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" Text="© 2026 Xxuebi" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="2,7"
                    Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="78" Margin="0,0,8,0" Style="{StaticResource ModernButton}"
                    Click="OnCancelClick" Content="取消" />
            <Button MinWidth="78" Style="{StaticResource AccentButton}"
                    Click="OnSaveClick" Content="保存" />
        </StackPanel>
    </Grid>
</Window>
