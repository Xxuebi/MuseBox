<Window x:Class="ScreenshotCollector.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑图片" Width="920" Height="650"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" PreviewKeyDown="OnEditorKeyDown" PreviewMouseDown="OnEditorPointerDown">
    <Window.Resources>
        <DrawingBrush x:Key="EditorCheckerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#FAFAFA" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#E2E5E8" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="38" /><Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="5" /><Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EditorIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}" /><Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" /><Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style x:Key="EditorNumber" TargetType="TextBox">
            <Setter Property="Width" Value="56" /><Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="1,0" /><Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnNumberMouseDown" />
            <EventSetter Event="GotKeyboardFocus" Handler="OnNumberFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnNumberCommit" />
            <EventSetter Event="PreviewKeyDown" Handler="OnNumberKeyDown" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="#719DAD" />
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="EditorSlider" TargetType="Slider">
            <Setter Property="Height" Value="25" /><Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="1" /><Setter Property="LargeChange" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnAdjustmentStart" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnAdjustmentEnd" />
            <EventSetter Event="LostMouseCapture" Handler="OnAdjustmentCaptureLost" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid>
                    <Border Height="4" Margin="7,0" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center" />
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template>
                            <ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="#6593A6" StrokeThickness="1.5" /></ControlTemplate>
                        </Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid x:Name="EditorSurface" Margin="20,12,20,18" Background="Transparent" Focusable="True">
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="48" />
                <RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock Text="编辑图片" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EditorButton}" Margin="0"
                        ToolTip="取消并关闭" AutomationProperties.Name="取消并关闭" Click="OnCancelClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M3,3 L17,17 M17,3 L3,17" />
                </Button>
            </Grid>
            <StackPanel x:Name="EditorTools" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CropModeButton" Style="{StaticResource EditorButton}" ToolTip="裁切" AutomationProperties.Name="裁切" Click="OnCropModeClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M5,1 V15 H19 M1,5 H15 V19 M8,5 H15 M5,8 V15" />
                </Button>
                <Border Width="1" Height="22" Background="{DynamicResource ControlBorderBrush}" Margin="5,0,10,0" />
                <Button Style="{StaticResource EditorButton}" ToolTip="水平翻转" AutomationProperties.Name="水平翻转" Tag="Horizontal" Click="OnTransformClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M10,1 V19 M7,4 L1,15 H7 Z M13,4 L19,15 H13 Z" />
                </Button>
                <Button Style="{StaticResource EditorButton}" ToolTip="垂直翻转" AutomationProperties.Name="垂直翻转" Tag="Vertical" Click="OnTransformClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M1,10 H19 M4,7 L15,1 V7 Z M4,13 L15,19 V13 Z" />
                </Button>
                <Button Style="{StaticResource EditorButton}" ToolTip="逆时针旋转 90°" AutomationProperties.Name="逆时针旋转90度" Tag="RotateLeft" Click="OnTransformClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M4,6 A8,8 0 1 1 2,13 M4,1 V6 H9" />
                </Button>
                <Button Style="{StaticResource EditorButton}" ToolTip="顺时针旋转 90°" AutomationProperties.Name="顺时针旋转90度" Tag="Rotate" Click="OnTransformClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M16,6 A8,8 0 1 0 18,13 M16,1 V6 H11" />
                </Button>
                <Border Width="1" Height="22" Background="{DynamicResource ControlBorderBrush}" Margin="5,0,10,0" />
                <Button x:Name="UndoEditorButton" Style="{StaticResource EditorButton}" ToolTip="撤回一步 (Ctrl+Z)" AutomationProperties.Name="撤回一步" Click="OnUndoClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M7,3 L1,8 L7,13 M2,8 H12 C21,8 21,19 12,19 H8" />
                </Button>
                <Button Style="{StaticResource EditorButton}" ToolTip="重置图片及颜色" AutomationProperties.Name="重置图片及颜色" Click="OnResetClick">
                    <Path Style="{StaticResource EditorIcon}" Data="M3,7 A8,8 0 1 1 3,15 M3,1 V7 H9" />
                </Button>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,8,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="10">
                    <Grid x:Name="PreviewHost" Background="{StaticResource EditorCheckerboard}" ClipToBounds="True" SizeChanged="OnPreviewSizeChanged">
                        <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                        <Canvas x:Name="CropCanvas" Background="Transparent" Cursor="Arrow"
                                MouseLeftButtonDown="OnCropDown" MouseMove="OnCropMove" MouseLeftButtonUp="OnCropUp">
                            <Path x:Name="CropShade" Fill="#66000000" IsHitTestVisible="False" />
                            <Rectangle x:Name="CropRectangle" Stroke="White" StrokeThickness="1.5" RadiusX="2" RadiusY="2"
                                       Fill="#105CA8C9" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Border x:Name="CropActions" Background="{DynamicResource CardBrush}" CornerRadius="9" Padding="3" Visibility="Collapsed">
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity=".16" /></Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CropApplyButton" Style="{StaticResource EditorButton}" Width="30" Height="28" Padding="5" Margin="0,0,2,0"
                                            ToolTip="确定裁切" AutomationProperties.Name="确定裁切" Click="OnCropApplyClick">
                                        <Path Style="{StaticResource EditorIcon}" Width="16" Height="16" Stroke="#26718A" Data="M2,10 L8,16 L19,3" />
                                    </Button>
                                    <Button Style="{StaticResource EditorButton}" Width="30" Height="28" Padding="5" Margin="0"
                                            ToolTip="取消裁切" AutomationProperties.Name="取消裁切" Click="OnCropCancelClick">
                                        <Path Style="{StaticResource EditorIcon}" Width="15" Height="15" Data="M3,3 L17,17 M17,3 L3,17" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Column="1" Margin="20,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="颜色调整" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                    <DockPanel><TextBlock Text="色相" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="HueValue" Style="{StaticResource EditorNumber}" Text="0" Tag="HueSlider" />
                            <TextBlock Text="°" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="HueSlider" Style="{StaticResource EditorSlider}" Minimum="-180" Maximum="180" Value="0"
                            Margin="0,3,0,12" ValueChanged="OnAdjustmentChanged">
                        <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F05C60" Offset="0" /><GradientStop Color="#F2D15B" Offset=".167" />
                            <GradientStop Color="#58CC70" Offset=".333" /><GradientStop Color="#52C5CB" Offset=".5" />
                            <GradientStop Color="#6382E1" Offset=".667" /><GradientStop Color="#CB65D8" Offset=".833" /><GradientStop Color="#F05C60" Offset="1" />
                        </LinearGradientBrush></Slider.Background>
                    </Slider>
                    <DockPanel><TextBlock Text="饱和度" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="SaturationValue" Style="{StaticResource EditorNumber}" Text="100" Tag="SaturationSlider" />
                            <TextBlock Text="%" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="SaturationSlider" Style="{StaticResource EditorSlider}" Minimum="0" Maximum="200" Value="100"
                            Margin="0,3,0,12" ValueChanged="OnAdjustmentChanged">
                        <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#AEB5BD" Offset="0" /><GradientStop Color="#F05766" Offset="1" /></LinearGradientBrush></Slider.Background>
                    </Slider>
                    <DockPanel><TextBlock Text="亮度" VerticalAlignment="Center" /><TextBox x:Name="BrightnessValue" HorizontalAlignment="Right" Style="{StaticResource EditorNumber}" Text="0" Tag="BrightnessSlider" /></DockPanel>
                    <Slider x:Name="BrightnessSlider" Style="{StaticResource EditorSlider}" Minimum="-100" Maximum="100" Value="0"
                            Margin="0,3,0,12" ValueChanged="OnAdjustmentChanged">
                        <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#343A40" Offset="0" /><GradientStop Color="#DFE3E7" Offset=".7" /><GradientStop Color="White" Offset="1" /></LinearGradientBrush></Slider.Background>
                    </Slider>
                    <DockPanel><TextBlock Text="对比度" VerticalAlignment="Center" /><TextBox x:Name="ContrastValue" HorizontalAlignment="Right" Style="{StaticResource EditorNumber}" Text="0" Tag="ContrastSlider" /></DockPanel>
                    <Slider x:Name="ContrastSlider" Style="{StaticResource EditorSlider}" Minimum="-100" Maximum="100" Value="0"
                            Margin="0,3,0,8" ValueChanged="OnAdjustmentChanged">
                        <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#BFC3C8" Offset="0" /><GradientStop Color="#4A535C" Offset="1" /></LinearGradientBrush></Slider.Background>
                    </Slider>
                    <DockPanel><TextBlock Text="透明度" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="OpacityValue" Style="{StaticResource EditorNumber}" Text="100" Tag="OpacitySlider" />
                            <TextBlock Text="%" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="OpacitySlider" Style="{StaticResource EditorSlider}" Minimum="0" Maximum="100" Value="100"
                            Margin="0,3,0,8" ValueChanged="OnAdjustmentChanged">
                        <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E2E5E8" Offset="0" /><GradientStop Color="#6593A6" Offset="1" />
                        </LinearGradientBrush></Slider.Background>
                    </Slider>
                    <TextBlock Text="点击数字可输入数值。&#x0a;Ctrl+Z 撤回一步。&#x0a;&#x0a;另存会在画板新增图片，&#x0a;保留原图片。"
                                TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Grid>
            <DockPanel Grid.Row="3" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource ModernButton}" MinWidth="74" Margin="0,0,8,0" Content="取消" Click="OnCancelClick" />
                    <Button x:Name="ApplyEditorButton" Style="{StaticResource ModernButton}" MinWidth="84" Margin="0,0,8,0" Content="应用" Click="OnApplyClick" />
                    <Button x:Name="SaveAsEditorButton" Style="{StaticResource AccentButton}" MinWidth="94" Content="另存" ToolTip="在画板新增图片，保留原图" Click="OnSaveAsClick" />
                </StackPanel>
                <TextBlock x:Name="EditorStatus" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
