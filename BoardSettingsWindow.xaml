<Window x:Class="ScreenshotCollector.BoardSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindow}"
        Title="画板设置" Width="500" MinHeight="430"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H8 V8 H0 Z" />
                    <GeometryDrawing Brush="#FFD7D7D7" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="RoundSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#88000000" StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchChrome" Padding="1"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchChrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="SwatchChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwatchChrome" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="画板外观" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}"
                       Text="设置仅应用于当前画板" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock FontWeight="SemiBold" Text="背景颜色" />
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="GrayscalePanel" Margin="-2,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PaletteButton}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnPaletteColorClick" />
                    <Button Style="{StaticResource PaletteButton}" Background="#A0A0A0" Tag="#A0A0A0" Click="OnPaletteColorClick" />
                    <Button Style="{StaticResource PaletteButton}" Background="#202020" Tag="#202020" Click="OnPaletteColorClick" />
                </WrapPanel>
                <WrapPanel x:Name="PastelPalettePanel" Grid.Column="1" Margin="-2,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PaletteButton}" Background="#F8B4B4" Tag="#F8B4B4" Click="OnPaletteColorClick" />
                    <Button Style="{StaticResource PaletteButton}" Background="#FBD38D" Tag="#FBD38D" Click="OnPaletteColorClick" />
                    <Button Style="{StaticResource PaletteButton}" Background="#FAF089" Tag="#FAF089" Click="OnPaletteColorClick" />
                    <Button Style="{StaticResource PaletteButton}" Background="#B7E4C7" Tag="#B7E4C7" Click="OnPaletteColorClick" />
                    <Button Style="{StaticResource PaletteButton}" Background="#BBD0FF" Tag="#BBD0FF" Click="OnPaletteColorClick" />
                </WrapPanel>
                <Button x:Name="CustomColorButton" Grid.Column="2" Height="32" Padding="9,0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Style="{StaticResource ModernButton}" Click="OnCustomColorClick">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CustomColorPreview" Width="18" Height="18" Margin="0,0,7,0"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                CornerRadius="4" />
                        <TextBlock VerticalAlignment="Center" Text="选择颜色…" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock FontWeight="SemiBold" Text="背景透明度" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="BackgroundOpacityTrack" Height="18" Margin="0,0,10,0"
                          ClipToBounds="True" Cursor="Hand"
                          PreviewMouseLeftButtonDown="OnOpacityTrackMouseDown"
                          PreviewMouseMove="OnOpacityTrackMouseMove"
                          PreviewMouseLeftButtonUp="OnOpacityTrackMouseUp">
                        <Border Background="{StaticResource CheckerBrush}" CornerRadius="8" />
                        <Border x:Name="BackgroundOpacityColorTrack" CornerRadius="8" />
                        <Slider x:Name="OpacitySlider" Style="{StaticResource RoundSlider}"
                                Minimum="10" Maximum="100" TickFrequency="5"
                                Focusable="False" IsHitTestVisible="False"
                                IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                                ValueChanged="OnOpacityValueChanged" />
                    </Grid>
                    <TextBlock x:Name="OpacityText" Grid.Column="1" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="透明度影响图片" />
                <ToggleButton x:Name="AffectImagesToggle" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Style="{StaticResource SwitchStyle}"
                              ToolTip="关闭时只让画板背景透明，图片保持不透明"
                              AutomationProperties.Name="透明度同时影响图片"
                              Checked="OnAffectImagesChanged" Unchecked="OnAffectImagesChanged" />
            </Grid>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="显示窗口边框和阴影" />
                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" Text="用于区分背景颜色相同或重叠的多个画板窗口" />
            </StackPanel>
            <ToggleButton x:Name="WindowFrameToggle" Grid.Column="1"
                          VerticalAlignment="Center" Style="{StaticResource SwitchStyle}"
                          AutomationProperties.Name="显示窗口边框和阴影"
                          Checked="OnWindowFrameChanged" Unchecked="OnWindowFrameChanged" />
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="72" Margin="0,0,8,0" Style="{StaticResource ModernButton}"
                    Content="恢复默认" Click="OnResetClick" />
            <Button MinWidth="72" Margin="0,0,8,0" Style="{StaticResource ModernButton}"
                    Content="取消" Click="OnCancelClick" />
            <Button x:Name="ApplyButton" MinWidth="72" Style="{StaticResource AccentButton}"
                    Content="应用" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</Window>
